<!DOCTYPE html>
<html lang="ja">

<style>
    @charset "UTF-8";

    html,
    body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
    }

    a {
        color: black;
    }

    a:visited {
        color: black;
    }

    .header-text {
        width: 100%;
        height: 80px;
        background-color: #bbb;
        display: flex;
        justify-content: space-between;
    }

    .header-text-title {
        font-size: 24px;
        margin-left: 20px;
    }

    .header-text-subtitle {
        font-size: 14px;
        margin-right: 20px;
        align-self: center;
    }

    .content {
        width: 100%;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .content-inner {
        margin-right: 60px;
    }

    .calendar-title {
        text-align: center;
        margin-bottom: 40px;
        margin-right: 60px;
    }

    .calendar-container {
        width: 500px;
        margin: 0 auto;
        border-radius: 5px;
        background-color: #e8e3d9;
        color: #1a1a1a;
        margin-right: 80px;
        justify-content: space-around;
    }

    @media (max-width: 1200px) {
        .calendar-container {
            width: 400px;
            margin-right: 20px;
        }

        .task-button {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            margin-bottom: 20px;
        }

        .calendar-title {
            margin-right: 0;
            padding-top: 20px;
        }

        .priority-title {
            padding-top: 20px;
        }
    }

    @media (max-width: 800px) {
        .content {
            display: flex;
            flex-direction: column-reverse;
            align-items: center;
        }

        .content-inner {
            margin-right: 0;
        }

        .calendar-title {
            padding-top: 60px;
            margin-right: 0;
        }

        .calendar-container {
            width: 100%;
            max-width: 400px;
            box-sizing: border-box;
            padding: 0 20px 30px 20px;
            margin-left: 10px;
            align-items: center;
            justify-content: center;
        }

        .calendar {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
        }

        .calendar th,
        .calendar td {
            text-align: center;
            padding: 8px 0;
            font-size: clamp(12px, 3.5vw, 16px);
        }

        .task-button {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            margin-bottom: 20px;
        }

        .priority-title {
            padding-top: 20px;
        }
    }

    h1 {
        height: 80px;
        line-height: 80px;
        text-align: center;
        font-size: 24px;
        margin: 0;
    }

    .calendar {
        padding: 0 30px 30px 30px;
    }

    table {
        width: 100%;
    }

    th,
    td {
        text-align: center;
        padding: 10px;
    }

    th {
        font-weight: normal;
        font-size: 14px;
    }

    td {
        font-weight: bold;
    }

    .day *:first-child {
        color: #ff838b;
    }

    .day *:last-child {
        color: #6fb5ff;
    }

    /*Priority*/
    .priority {
        margin-left: 30px;
        margin-right: 30px;
    }

    .rest-day {
        font-size: 16px;
    }

    .priority-title {
        text-align: center;
        padding-top: 40px;
        margin-bottom: 20px;
    }

    .priority-text-over-list {
        font-weight: bold;
        font-size: 20px;
        color: #9A55F3;
    }

    .priority-text-first-list {
        font-weight: bold;
        font-size: 20px;
        color: #FF4D4F;
    }

    .priority-text-second-list {
        font-weight: bold;
        font-size: 20px;
        color: #FFb000;
    }

    .priority-text-third-list {
        font-weight: bold;
        font-size: 20px;
        color: #555;
    }

    /*タスクの追加*/
    .task-button {
        display: flex;
        justify-content: center;
        margin-right: 60px;
    }

    .button {
        border: none;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.2);
        border-radius: 5px;
        display: flex;
        align-items: center;
        padding: 10px;
        margin: 10px;
        background-color: #FBC700;
    }

    .button:hover {
        transform: translateY(-3px);
        box-shadow: 0px 5px 10px rgba(0, 0, 0, 0.3);
    }

    .task-button-icon {
        width: 20px;
        height: 20px;
        margin-right: 10px;
    }

    @media (max-width: 800px) {
        .button {
            justify-content: center;
        }

        .task-button {
            flex-direction: row;
            justify-content: center;
        }
    }

    /*タスクの表示*/
    .task-status {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }

    .task-status-title {
        margin-top: 0;
        margin-bottom: 30px;
    }

    .status-board {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px 20px;
    }

    .status-column {
        flex: 1;
        min-width: 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .rest-day-header {
        font-size: 20px;
        font-weight: normal;
        margin-bottom: 20px;
        text-align: center;
        color: #ef0000;
    }

    .day-header {
        font-size: 20px;
        font-weight: normal;
        margin-bottom: 20px;
        text-align: center;
    }

    .rest-task-card {
        width: 100%;
        min-height: 260px;
        padding: 20px 15px;
        box-sizing: border-box;
        background-color: #ffd6d6;
        color: #ef0000;
        border-radius: 20px;
    }

    .task-card {
        width: 100%;
        min-height: 260px;
        padding: 20px 15px;
        box-sizing: border-box;
        background-color: #dcdcdc;
        border-radius: 20px;
    }

    .task-list {
        list-style-type: disc;
        padding-left: 20px;
        margin: 0;
    }

    .task-list li {
        font-size: 16px;
        margin-bottom: 25px;
        line-height: 1.4;
    }

    @media (max-width: 800px) {
        .task-status {
            padding: 10px;
            padding-bottom: 30px;
        }

        .status-board {
            grid-template-columns: repeat(2, 1fr);
            gap: 20px 15px;
        }

        .task-card {
            min-height: 160px;
        }

        .rest-task-card {
            min-height: 160px;
        }
    }

    /*Footer*/
    .footer {
        background-color: #555;
        width: 100vw;
        height: 40px;
        margin-left: calc(50%-100vw);
        padding: 20px 0;
        text-align: center;
    }

    .task-button form {
        display: inline-block;
        margin: 0;
    }

    .calendar td {
        position: relative;
        padding-bottom: 16px;
    }

    .task-dot-container {
        position: absolute;
        bottom: 2px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        gap: 2px;
    }

    .task-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background-color: #ff838b;
    }
</style>

<head>
    <meta charset="UTF-8">

    <title>My Website</title>

</head>

<body>
    <div class="wrapper">
        <header class="header">
            <div class="header-text">
                <p class="header-text-title">
                    タスク管理アプリ
                </p>
                <!--<p class="header-text-subtitle">
                    ユーザー名
                </p>-->
            </div>
        </header>

        <div class="content">
            <div class="content-inner">

                <!-- calendar -->
                <h1 class="calendar-title">
                    calendar
                </h1>
                <div class="calendar-container">
                    <h1><%= Time.zone.today.strftime("%B %Y") %></h1>
                    <table class="calendar">
                        <tr>
                            <th>SUN</th>
                            <th>MON</th>
                            <th>TUE</th>
                            <th>WED</th>
                            <th>THU</th>
                            <th>FRI</th>
                            <th>SAT</th>
                        </tr>

                        <%
                        first_day = Time.zone.today.beginning_of_month
                        last_day = Time.zone.today.end_of_month
                        start_offset = first_day.wday # 1日が何曜日か(0=日曜)
                        all_days = Array.new(start_offset, nil) + (first_day..last_day).to_a
                        weeks = all_days.each_slice(7)
                        %>

                        <% weeks.each do |week| %>
                        <tr class="day">
                            <% week.each do |date| %>
                            <td>
                                <% if date %>
                                <%= date.day %>
                                <% count = @task_counts_by_date[date] || 0 %>
                                <% if count > 0 %>
                                    <div class="task-dot-container">
                                    <% count.times do %>
                                        <span class="task-dot"></span>
                                    <% end %>
                                    </div>
                                <% end %>
                                <% end %>
                            </td>
                            <% end %>
                        </tr>
                        <% end %>
                    </table>
                </div>

                <!-- Task Buttons -->
                <div class="task-button">
                    <%= button_to new_task_path, method: :get, class: 'button' do %>
                        <%= image_tag('group13.png', alt: 'Icon', class: 'task-button-icon') %>
                        <span class="task-button-text">課題を入力する</span>
                    <% end %>

                    <%= button_to tasks_path, method: :get, class: 'button' do %>
                        <%= image_tag('group14.png', alt: 'Icon', class: 'task-button-icon') %>
                        <span class="task-button-text">タスクを編集する</span>
                    <% end %>
                </div>
            </div>

            <!-- Priority -->
            <div class="priority">
                <h1 class="priority-title">
                    Priority
                </h1>
                <div class="priority-text-over">
                    <h2 class="rest-day">期限切れ</h2>
                    <div class="priority-text-over-text">
                        <ul>
                            <% @overdue_tasks.each do |task| %>
                            <li>
                                <p class="priority-text-over-list"><%= task.subject %></p>
                            </li>
                            <% end %>
                        </ul>
                    </div>
                </div>
                <div class="priority-text-first">
                    <h2 class="rest-day">今日まで</h2>
                    <div class="priority-text-first-text">
                        <ul>
                            <% @today_tasks.each do |task| %>
                            <li>
                                <p class="priority-text-first-list"><%= task.subject %></p>
                            </li>
                            <% end %>
                        </ul>
                    </div>
                </div>

                <div class="priority-text-second">
                    <h2 class="rest-day">明日まで</h2>
                    <div class="priority-text-second-text">
                        <ul>
                            <% @tomorrow_tasks.each do |task| %>
                            <li>
                                <p class="priority-text-second-list"><%= task.subject %></p>
                            </li>
                            <% end %>
                        </ul>
                    </div>
                </div>

                <div class="priority-text-third">
                    <h2 class="rest-day">明後日まで</h2>
                    <div class="priority-text-third-text">
                        <ul>
                            <% @two_days_tasks.each do |task| %>
                            <li>
                                <p class="priority-text-third-list"><%= task.subject %></p>
                            </li>
                            <% end %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <br>
        <br>
        <br>


        <div class="task-status">
            <h1 class="task-status-title">
                Task Status
            </h1>

           <div class="status-board">
                <% @days_tasks.each_with_index do |tasks_for_day, days| %>
                    <div class="<%= days == 0 ? 'status-urgent' : 'status-column' %>">
                        <div class="<%= days == 0 ? 'rest-day-header' : 'day-header' %>">
                            残り<%= days %>日
                        </div>
                        <div class="<%= days == 0 ? 'rest-task-card' : 'task-card' %>">
                            <ul class="task-list">
                                <% tasks_for_day.each do |task| %>
                                    <li><%= task.subject %>:<%= task.title %></li>
                                <% end %>
                            </ul>
                        </div>
                    </div>
                <% end %>
            </div>
        </div>

        <!--Footer-->
        <div class="footer">
            <div class="footer-inner">
                <!--<p class="copyright">© 2026 Hackit_Cirkit-a</p>-->
            </div>
        </div>

    </div>
</body>

</html>