<%# app/views/tasks/index.html.erb %>



<!DOCTYPE html>
<html lang="ja">

 <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scalse=1.0">

    <%= stylesheet_link_tag 'new', media: 'all' %>
 </head>


 <body>
    <div class="header">
            <div class="text">
                <h1>☆課題入力Form☆</h1>
            </div>
    </div>
    <a href="#" class="back-btn">&lt; 戻る</a>
    <div class="wrapper">
        
        <div class="subject">
             <div class="form-up">
                <ul>
                    <li>科目名</li>
                </ul>
                <div class="input">
                    <input type="text" name="username" placeholder="例:修学基礎A">
                </div>
             </div>
        </div>

        <div class="subject_1">
            <div class="text">
                <ul>
                    <li>課題内容</li>
                </ul>
                <div class="input_1">
                    <textarea placeholder="例：メニュー考案"></textarea>
                </div>
            </div>
        </div>
    
        <div class="subject_2">
            <div class="text">
                <ul>
                    <li>詳細</li>
                </ul>
                <div class="input_2">
                    <textarea placeholder="例：1000円くらいする"></textarea>
                </div>
            </div>
        </div>

        <div class="subject_3">
            <div class="text">
                <ul>
                    <li>提出期限</li>
                </ul>
                <div class="input_3">
                    <input type="text" name="username" placeholder="例:2099年/99月/99日/23:59">
                </div>
            </div>
        </div>

        <div class="button">
            <button class="favorite styled" type="button">追加する</button>
        </div>
    </div>
    
 </body>
</html>